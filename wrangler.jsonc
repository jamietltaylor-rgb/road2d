{
  // Cloudflare settings for Lost Roads.
  // Deploy as a Worker with the deploy command: npx wrangler deploy
  // worker.js serves the game's files and runs the logins, saves and leaderboard.
  // The storage (a Durable Object called LostRoadsDB) is created automatically.
  "name": "lost-roads",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "DB", "class_name": "LostRoadsDB" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LostRoadsDB"] }]
}
